<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blackColor">
    <FrameLayout
        android:id="@+id/surface_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </FrameLayout>
    <LinearLayout
        android:id="@+id/url_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/whiteColor"
            android:text="流名称:"/>
        <EditText
            android:id="@+id/url_input_view"
            android:background="@drawable/rounded_edittext"
            android:layout_width="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/whiteColor"
            android:layout_height="wrap_content"
            android:minHeight="35dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/pull_info_text_view"
        app:layout_constraintTop_toBottomOf="@+id/url_input_layout"
        android:layout_width="match_parent"
        android:textColor="@color/whiteColor"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <LinearLayout
        android:id="@+id/buttons"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ToggleButton
            android:id="@+id/play_control"
            android:background="@drawable/state_button_bg_color"
            android:textColor="@drawable/state_button_text_color"
            android:onClick="playControl"
            android:layout_margin="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textOn="停止播放"
            android:textOff="开始播放"/>
        <ToggleButton
            android:id="@+id/switchSmallWindowBtn"
            android:background="@drawable/state_button_bg_color"
            android:textColor="@drawable/state_button_text_color"
            android:layout_margin="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textOff="打开小窗"
            android:textOn="关闭小窗" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>